# Variáveis usadas pelas APIs serverless do projeto novo-site.
# Configure estes valores nas Environment Variables do projeto na Vercel.
# Nunca use o prefixo VITE_ para chaves secretas.

# Inteligência artificial
OPENAI_API_KEY=COLE_SUA_CHAVE_OPENAI_AQUI
OPENAI_MODEL=gpt-4o-mini
# Opcional: endpoint OpenAI-compatible alternativo
# OPENAI_API_BASE=https://api.openai.com/v1

# Entrega de contatos
RESEND_API_KEY=COLE_SUA_CHAVE_RESEND_AQUI
RESEND_FROM_EMAIL=contato@notificacao.maginf.com.br
RESEND_FROM_NAME=Site MAGINF
RESEND_CONTACT_TO=site@maginf.com.br
